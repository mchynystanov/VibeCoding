# Nginx reverse-proxy для Paomma Shop — живёт на поддомене paomma.luvsbaby.club
# (сам домен luvsbaby.club зарезервирован под будущую отдельную главную
# страницу бренда — этот конфиг её не трогает).
#
# 1. Скопируйте на сервер: /etc/nginx/sites-available/paomma
# 2. Включите: sudo ln -s /etc/nginx/sites-available/paomma /etc/nginx/sites-enabled/
# 3. Проверьте конфиг: sudo nginx -t
# 4. Перезапустите: sudo systemctl reload nginx
# 5. Выпустите SSL-сертификат (сам допишет HTTPS-блок и настроит редирект):
#      sudo certbot --nginx -d paomma.luvsbaby.club

server {
    listen 80;
    listen [::]:80;
    server_name paomma.luvsbaby.club;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
