# TODO(owner): открытый вопрос №1 — телеграм-юзернейм/номер для чата и
# резервной ссылки не предоставлены на момент написания ТЗ.
TELEGRAM_BOT_TOKEN=
# Можно указать несколько id через запятую — заказ придёт всем сразу:
# TELEGRAM_CHAT_ID=111111111,222222222
TELEGRAM_CHAT_ID=

# Кнопки статуса заказа (Обработан/Отправлен/Отменён) под сообщением в
# Telegram: любая случайная строка, её же Telegram возвращает в заголовке
# запроса к /api/telegram/webhook для проверки подлинности. Сгенерировать,
# например: node -e "console.log(crypto.randomUUID())"
# После задания — зарегистрировать вебхук: npm run telegram:set-webhook --
# https://ВАШ_ДОМЕН/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

NEXT_PUBLIC_WHATSAPP_FALLBACK=   # номер в формате 996700123456
NEXT_PUBLIC_TELEGRAM_FALLBACK=   # @username

# Админка /admin (смена цены/наличия товаров): логин/пароль здесь НЕ нужны —
# задаются прямо на /admin при первом заходе и хранятся в
# data/admin-credentials.json (гитигнорится), см. src/lib/adminAuth.ts.
