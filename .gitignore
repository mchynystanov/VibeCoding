dist/
build/
out/
.next/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/

# Claude Code local settings (личные, не для команды)
.claude/settings.local.json

