# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Runtime data written by the admin panel (price/stock overrides) —
# lives on the server's disk, not in git; see data/product-overrides.example.json
data/product-overrides.json

# Real customer reviews submitted through the site — user-generated
# runtime data, not source, so it doesn't belong in git either.
data/reviews.json

# Admin panel login (hashed password + session secret), set from the
# /admin first-run setup screen — never checked into git.
data/admin-credentials.json

